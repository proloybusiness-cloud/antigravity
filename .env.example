# ==============================================================================
# Antigravity Flow — Gen 1 Configuration
# Copy this file to .env and fill in values when deploying to Hostinger.
# Out of the box (no .env), everything runs cleanly in local test mode!
# ==============================================================================

# --- Core Engine & Hostinger Runtime ---
PORT=3777
HOST=0.0.0.0
NODE_ENV=development
DATA_DIR=./data
WORKFLOWS_DIR=./workflows

# Protect API & webhooks when exposed publicly on Hostinger (leave blank locally)
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_WEBHOOK_SECRET=

# Set to "false" to disable the built-in background cron ticker
SCHEDULER_ENABLED=true

# --- Remote Brain CLI Target (used by Antigravity CLI to control Hostinger) ---
# ANTIGRAVITY_REMOTE_URL=https://flow.yourdomain.com

# --- Storage Drive (Google Drive API v3) ---
# Mode: "auto" (live if credentials set, else local sandbox), "live", or "local"
GDRIVE_MODE=auto
GOOGLE_DRIVE_FOLDER_ID=

# Option A: Google Service Account (recommended for 24/7 Hostinger server)
# Provide either raw JSON string OR file path to service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=

# Option B: Google OAuth2 Refresh Token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- GitHub Integration ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=proloybusiness-cloud/antigravity

# --- Optional LLM / Brain Node (OpenAI-compatible endpoint) ---
# Leave blank to use the built-in deterministic local summarizer for free testing
BRAIN_API_URL=https://api.openai.com/v1/chat/completions
BRAIN_API_KEY=
BRAIN_MODEL=gpt-4o-mini
